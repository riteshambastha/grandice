# Point the router anywhere OpenAI-compatible. Leave unset to run the stub
# router — the loop, tools, sandbox and ledger all still work, only the model
# is scripted.
GRANDICE_BASE_URL=https://openrouter.ai/api/v1
GRANDICE_API_KEY=

# Model tiers (§03). Defaults are OpenRouter's current free-tier ("$0" priced)
# models, picked from a live catalog check on 2026-09-12 — not from memory.
# The free roster "shifts constantly": re-check openrouter.ai/models (filter
# Pricing -> Free) every few weeks, and swap any id that stops resolving.
GRANDICE_ORCHESTRATOR=nvidia/nemotron-3-ultra-550b-a55b:free
GRANDICE_WORKER=nvidia/nemotron-3-super-120b-a12b:free
GRANDICE_BULK=nvidia/nemotron-3.5-lightning:free

# --- Alternative: a first-party key instead of OpenRouter's free tier -----
# Z.ai (GLM) is one of the providers §03 names as worth moving to once you
# know what you use. Verified against docs.z.ai on 2026-09-12 — not from
# training memory, since Z.ai has shipped newer models (GLM-4.7, GLM-5.x)
# since. To switch, uncomment all four lines below (they replace the
# OpenRouter block above — one base_url/api_key currently serves all three
# tiers, so all three model ids must come from the same provider):
#
# GRANDICE_BASE_URL=https://api.z.ai/api/paas/v4
# GRANDICE_API_KEY=                          # your Z.ai key — never commit this
# GRANDICE_ORCHESTRATOR=glm-4.6              # $0.60/$2.20 per Mtok — tuned for agentic tool use
# GRANDICE_WORKER=glm-4.5-air                # $0.20/$1.10 per Mtok
# GRANDICE_BULK=glm-4.5-flash                # listed free on Z.ai's pricing page as of the same check —
#                                             # confirm current status yourself before relying on it
#
# First thing to check once you try it: if the cost ledger ($/api/state's
# "cost" field, or /cost in the CLI) stays at $0.0000 across real calls, Z.ai
# isn't returning token usage on `stream_options.include_usage` the way
# OpenRouter does — cosmetic (nothing crashes, the cap just can't trip), but
# worth knowing.

# OpenRouter's free tier is rate-limited, not (usefully) credit-limited:
# 20 requests/minute always; 50/day for free, 1,000/day after a one-time
# (non-recurring) $10 credit purchase. One agentic task can spend 30-120
# calls, so 50/day is exhausted in under two tasks — the $10 top-up is a
# one-time cost, not a subscription, and is worth making before real use.
#
# These numbers are OpenRouter-free-tier-specific. On a first-party key
# (Z.ai included) they're almost certainly too restrictive — raise both, or
# set the daily cap very high, once you're not on OpenRouter's free models.
GRANDICE_REQUESTS_PER_MINUTE=18
GRANDICE_DAILY_REQUEST_CAP=50

# Hard per-session dollar cost cap (§11). On free-tier models this reads ~$0 —
# it exists for the day you point GRANDICE_ORCHESTRATOR at a paid model.
GRANDICE_COST_CAP_USD=2.00

# Sandbox backend: sandbox-exec (macOS only) | docker (Linux/EC2) | none.
# Leave unset — Config.from_env() already picks sandbox-exec on macOS and
# docker everywhere else. Only set this to override that.
# GRANDICE_SANDBOX=docker

# Image the docker sandbox runs each exec in. Build it once (it bakes in
# openpyxl and python-pptx for the xlsx/pptx skills — the sandbox has no
# network access to pip install them at runtime):
#   docker build -t grandice-sandbox:py3.12 sandbox/
GRANDICE_SANDBOX_IMAGE=grandice-sandbox:py3.12
