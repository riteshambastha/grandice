# Point the router anywhere OpenAI-compatible. Leave unset to run the stub
# router — the loop, tools, sandbox and ledger all still work, only the model
# is scripted.
GRANDICE_BASE_URL=https://openrouter.ai/api/v1
GRANDICE_API_KEY=

# --- Alternative: a private, self-hosted gateway (e.g. Ollama over Tailscale) ---
# Use GRANDICE_LLM_* instead of the above — they take priority when both are
# set, and both must be set together or Config.from_env() raises a clear
# ConfigError rather than silently doing something else. Put the real key in
# .env.local (gitignored), never here or in .env — see .env.local's own
# comments for exactly what to edit.
#
# GRANDICE_LLM_BASE_URL=https://your-tailscale-host.ts.net/v1
# GRANDICE_LLM_API_KEY=                      # your gateway key — never commit this; put it in .env.local
# GRANDICE_LLM_CHAT_MODEL=chat               # sets all three tiers unless GRANDICE_ORCHESTRATOR/WORKER/BULK override it
# GRANDICE_LLM_EMBEDDING_MODEL=embed         # not consumed by any feature yet — see router.py's Router.embed()
# GRANDICE_LLM_TIMEOUT_SECONDS=60            # a self-hosted model can be slow on a cold start or under CPU load
#
# A private box has no external rate limit, so GRANDICE_REQUESTS_PER_MINUTE/
# GRANDICE_DAILY_REQUEST_CAP default much higher automatically when
# GRANDICE_LLM_* is what's live — set them explicitly only if you actually
# want a cap.

# Model tiers (§03). Defaults are OpenRouter's current free-tier ("$0" priced)
# models, picked from a live catalog check on 2026-09-12 — not from memory.
# The free roster "shifts constantly": re-check openrouter.ai/models (filter
# Pricing -> Free) every few weeks, and swap any id that stops resolving.
GRANDICE_ORCHESTRATOR=nvidia/nemotron-3-ultra-550b-a55b:free
GRANDICE_WORKER=nvidia/nemotron-3-super-120b-a12b:free
GRANDICE_BULK=nvidia/nemotron-3.5-lightning:free

# --- Alternative: a first-party key instead of OpenRouter's free tier -----
# §03 names moving to a first-party vendor (Moonshot, Z.ai, DeepSeek, ...)
# once you know what you use. The router is provider-agnostic — point
# GRANDICE_BASE_URL/API_KEY at any OpenAI-compatible endpoint and set the
# three model ids to that provider's own. One base_url/api_key currently
# serves all three tiers, so all three model ids must come from the same
# provider. Verify a new provider's field names/behaviour live before
# trusting it (see mcp_client.py's module docstring for why that caution
# isn't hypothetical in a fast-moving ecosystem).
#
# First thing to check once you try one: if the cost ledger ($/api/state's
# "cost" field, or /cost in the CLI) stays at $0.0000 across real calls, the
# provider isn't returning token usage on `stream_options.include_usage` the
# way OpenRouter does — cosmetic (nothing crashes, the cap just can't trip),
# but worth knowing.

# OpenRouter's free tier is rate-limited, not (usefully) credit-limited:
# 20 requests/minute always; 50/day for free, 1,000/day after a one-time
# (non-recurring) $10 credit purchase. One agentic task can spend 30-120
# calls, so 50/day is exhausted in under two tasks — the $10 top-up is a
# one-time cost, not a subscription, and is worth making before real use.
#
# These numbers are OpenRouter-free-tier-specific. On a first-party key
# (Z.ai included) they're almost certainly too restrictive — raise both, or
# set the daily cap very high, once you're not on OpenRouter's free models.
GRANDICE_REQUESTS_PER_MINUTE=18
GRANDICE_DAILY_REQUEST_CAP=50

# Hard per-session dollar cost cap (§11). On free-tier models this reads ~$0 —
# it exists for the day you point GRANDICE_ORCHESTRATOR at a paid model.
GRANDICE_COST_CAP_USD=2.00

# Sandbox backend: sandbox-exec (macOS only) | docker (Linux/EC2) | none.
# Leave unset — Config.from_env() already picks sandbox-exec on macOS and
# docker everywhere else. Only set this to override that.
# GRANDICE_SANDBOX=docker

# Image the docker sandbox runs each exec in. Build it once (it bakes in
# openpyxl and python-pptx for the xlsx/pptx skills — the sandbox has no
# network access to pip install them at runtime):
#   docker build -t grandice-sandbox:py3.12 sandbox/
GRANDICE_SANDBOX_IMAGE=grandice-sandbox:py3.12

# MCP connectors (§P3). Comma-separated, empty by default. Requires the
# `mcp` extras group: pip install -e ".[mcp]". Unlike the sandboxed tools,
# connectors run in the harness process itself with real network access —
# that's deliberate (§07: "Connectors attach at the tool layer, never inside
# the sandbox"), and it's the whole reason `fetch` can work at all.
#
# fetch  — fetches a URL, converts to markdown. Gated behind the permission
#          prompt (Risk.OUTWARD): it leaves the machine. In the web
#          dashboard this currently always denies, since there's no
#          in-browser approval UI yet (§P5) — use the CLI to actually use it.
# sqlite — read_query/write_query/create_table/list_tables/describe_table
#          against one local .db file. Not gated — same trust level as the
#          built-in read/write tools.
#
# Neither is active by default even when configured — both stay latent
# until the model calls search_tools(query), the same on-demand pattern
# skills use for their own instructions (§05.2, §07).
# GRANDICE_MCP_CONNECTORS=fetch,sqlite
GRANDICE_MCP_SQLITE_PATH=workspace.db

# Subagents (§P4). A smaller step cap than the orchestrator's own — bounded,
# mechanical work is the point; something needing this many steps probably
# belongs to the orchestrator directly instead.
GRANDICE_SUBAGENT_MAX_STEPS=40
