# Point the router anywhere OpenAI-compatible. Leave unset to run the stub router.
GRANDICE_BASE_URL=https://openrouter.ai/api/v1
GRANDICE_API_KEY=

# Model tiers (§03). Any OpenAI-compatible model id.
GRANDICE_ORCHESTRATOR=z-ai/glm-4.6
GRANDICE_WORKER=minimax/minimax-m2
GRANDICE_BULK=openai/gpt-oss-120b

# Hard per-session cost cap in USD (§11). The loop aborts when exceeded.
GRANDICE_COST_CAP_USD=2.00

# Sandbox backend: sandbox-exec | none
GRANDICE_SANDBOX=sandbox-exec
